# ==============================================================================
# GallaVaani Environment Configuration
# ==============================================================================

# Gnani AI Speech APIs
GNANI_API_KEY="your_gnani_api_key_here"
GNANI_API_BASE_URL="https://api.vachana.ai"

# Meta WhatsApp Cloud API (v21.0+)
WHATSAPP_VERIFY_TOKEN="gallavaani_verify_token_here"
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_token_here"
WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id_here"
WHATSAPP_APP_SECRET="your_meta_app_secret_here"

# Allowed Test Phone Numbers (Comma-separated E.164 strings)
ALLOWED_TEST_NUMBERS="+919876543210,+919123456789"

# Optional LLM Reasoning Fallback
GEMINI_API_KEY=""

# Database & In-Memory State
DATABASE_URL="sqlite+aiosqlite:///gallavaani.db"
REDIS_URL="redis://localhost:6379/0"

# Application Settings
DEBUG=False
APP_ENV="development"
PORT=8000
